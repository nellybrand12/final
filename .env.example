# ==============================================================================
# HÔTEL RÉSIDENCE MADADJEU - ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# 1. DATABASE CONFIGURATION (PostgreSQL / Drizzle ORM)
# - For Supabase Pooler (Transaction Mode, port 6543):
#   DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require"
# - For Direct Supabase Connection (Session/Direct, port 5432):
#   DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
# If empty, runs in local in-memory fallback mode.
DATABASE_URL=""
DIRECT_URL=""

# 2. SUPABASE CONFIGURATION
PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# 3. APPLICATION & HOST SETTINGS
PUBLIC_APP_URL="http://localhost:5173"
NODE_ENV="development"
